@using BoutiqueQuantity.Entities
@model List<Product>
<style>
        .card{

        border-radius:20px;

        }

        .card-body{

        padding:20px;

        }

        .btn{

        border-radius:12px;

        font-size:14px;

        }

        .badge{

        font-size:12px;

        }

</style>
<div class="container mt-4">

    <div class="row mb-4">

        <div class="col-md-6">

            <h2>
                Управување со залиха
            </h2>

            <small class="text-muted">
                Бутик систем
            </small>

        </div>

        <div class="col-md-6">

            <form method="get" id="searchForm">

                <div class="input-group">

                    <input id="searchInput"
                           name="пребарување"
                           class="form-control"
                           value="@Context.Request.Query["пребарување"]"
                           placeholder="Пребарај шифра, име, боја, величина..." />

                    <span class="input-group-text">
                        🔍
                    </span>

                </div>

            </form>
          

        </div>

    </div>


    <div class="row">
        @if (User.IsInRole("Admin"))
        {
            <br />
            <div class="mb-4">

                <a asp-controller="Home"
                   asp-action="Create"
                   class="btn btn-dark">

                    ➕ Додади артикл

                </a>

            </div>
        }

          
        @foreach (var p in Model)
        {
            var vkupnaKolicina =
            p.Variants
            .SelectMany(v => v.Inventories)
            .Sum(x => x.Quantity);

            var boi = string.Join(", ",
                p.Variants
                .Select(x => x.Color)
                .Distinct());

            var golemini = string.Join(", ",
                p.Variants
                .SelectMany(x => x.Inventories)
                .Select(x => x.Size)
                .Distinct());

            <div class="col-12 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <h5 class="fw-bold mb-1">

                                    @p.Name

                                </h5>

                                <div class="text-muted">

                                    <div class="text-muted">@p.Category.Name</div>
                                </div>

                            </div>

                            <span class="badge bg-dark p-2">

                                @p.ProductCode

                            </span>

                        </div>


                        <hr />

                        <div class="row text-center">

                            <div class="col-6">

                                <div class="small text-muted">

                                    Бои

                                </div>

                                <div class="fw-bold">

                                    @boi

                                </div>

                            </div>

                            <div class="col-6">

                                <div class="small text-muted">

                                    Величини

                                </div>

                                <div class="fw-bold">

                                    @golemini

                                </div>

                            </div>

                        </div>


                        <div class="mt-3">

                            <span class="badge bg-success p-2">

                                Залиха: @vkupnaKolicina парчиња

                            </span>

                        </div>


                        <div class="row mt-3">

                            <div class="col-4">

                                <a asp-controller="Home"
                                   asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="btn btn-primary w-100">

                                    Детали

                                </a>

                            </div>

                            <div class="col-4">

                                <a asp-controller="Home"
                                   asp-action="Edit"
                                   asp-route-id="@p.Id"
                                   class="btn btn-warning w-100">
                                    Измени
                                </a>

                            </div>

                            <div class="col-4">

                                <a asp-controller="Sale"
                                   asp-action="Sale"
                                   asp-route-id="@p.Id"
                                   class="btn btn-success w-100">

                                    Продади

                                </a>

                            </div>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="col-12 mt-2">

                                    <a asp-controller="Home"
                                       asp-action="Delete"
                                       asp-route-id="@p.Id"
                                       class="btn btn-danger w-100">

                                        Избриши

                                    </a>

                                </div>
                            }
                        </div>

                    </div>

                </div>

            </div>

        }

    </div>

</div>
<script>
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let filter = this.value.toLowerCase();
        let cards = document.querySelectorAll(".card"); // сите cards на продукти

        cards.forEach(card => {
            // земи text на артикл: име, категорија, шифра, бои, величини
            let name = card.querySelector("h5.fw-bold")?.textContent.toLowerCase() || "";
            let category = card.querySelector("div.text-muted")?.textContent.toLowerCase() || "";
            let code = card.querySelector("span.badge.bg-dark")?.textContent.toLowerCase() || "";
            let colors = Array.from(card.querySelectorAll("div.row div.col-6 .fw-bold"))[0]?.textContent.toLowerCase() || "";
            let sizes = Array.from(card.querySelectorAll("div.row div.col-6 .fw-bold"))[1]?.textContent.toLowerCase() || "";

            if(name.includes(filter) ||
               category.includes(filter) ||
               code.includes(filter) ||
               colors.includes(filter) ||
               sizes.includes(filter))
            {
                card.parentElement.style.display = ""; // покажи
            }
            else
            {
                card.parentElement.style.display = "none"; // скриј
            }
        });
    });
</script>