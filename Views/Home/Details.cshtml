@model Product
@using System.Linq
@using BoutiqueQuantity.Entities
<style>

    .card {
        border-radius: 20px;
    }

    .accordion-item {
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        overflow: hidden;
    }


    .badge {
        font-size: 13px;
    }


    .btn {
        border-radius: 12px;
    }


    .accordion-button {
        font-size: 16px;
        font-weight: 600;
    }

</style>
<div class="container mt-3">

    <div class="card shadow border-0 mb-3">

        <div class="card-body">

            <div class="d-flex justify-content-between">

                <div>

                    <h3 class="fw-bold mb-1">

                        @Model.Name

                    </h3>

                    <div class="text-muted">

                        @Model.Category.Name

                    </div>

                </div>

                <span class="badge bg-dark p-2">

                    @Model.ProductCode

                </span>

            </div>


            <hr />


            <div class="row text-center">

                <div class="col-6">

                    <div class="small text-muted">

                        Продажна цена

                    </div>

                    <div class="fw-bold text-success">

                        @Model.SalePrice ден.

                    </div>

                </div>

                <div class="col-6">

                    <div class="small text-muted">

                        Набавна цена

                    </div>

                    <div class="fw-bold">

                        @Model.PurchasePrice ден.

                    </div>

                </div>

            </div>

        </div>

    </div>



    <h5 class="mb-3">

        Варијанти

    </h5>


    <div class="accordion"
         id="variantAccordion">

        @for (int i = 0; i < Model.Variants.Count; i++)
        {
            var variant =
            Model.Variants.ElementAt(i);

            var total =
            variant.Inventories.Sum(
            x => x.Quantity);

            <div class="accordion-item mb-2 rounded">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#v_@variant.Id">

                        <div class="w-100 d-flex justify-content-between">

                            <div>

                                <strong>

                                    @variant.Color

                                </strong>

                            </div>

                            <span class="badge bg-success me-4">

                                @total парчиња

                            </span>

                        </div>

                    </button>

                </h2>


                <div id="v_@variant.Id"
                     class="accordion-collapse collapse"
                     data-bs-parent="#variantAccordion">

                    <div class="accordion-body">


                        <div class="mb-3">

                            <div class="small text-muted">

                                Баркод

                            </div>

                            <div>

                                @variant.Barcode

                            </div>

                        </div>



                        <div class="mb-3">

                            <div class="small text-muted mb-2">

                                Величини

                            </div>


                            <div class="d-flex flex-wrap gap-2">

                                @foreach (var inv
                               in variant.Inventories)
                                {
                                    <span class="badge
                                        bg-secondary p-2">

                                        @inv.Size

                                        :

                                        @inv.Quantity

                                    </span>
                                }

                            </div>

                        </div>



                        <div class="row">

                            <div class="col-4">

                                <a asp-action="Edit"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-warning w-100">

                                    Измени

                                </a>

                            </div>
                           

                            <div class="col-4">

                                <a asp-controller="Sales"
                                   asp-action="Create"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-success w-100">

                                    Продади

                                </a>

                            </div>
                        </div>


                    </div>

                </div>

            </div>

        }

    </div>



    <div class="mt-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-dark w-100">

            ← Назад

        </a>

    </div>

</div>


