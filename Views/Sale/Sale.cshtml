@using BoutiqueQuantity.Entities
@model Product

<style>

    .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .btn {
        border-radius: 14px;
        height: 50px;
    }

    .form-select,
    .form-control {
        height: 55px;
        border-radius: 14px;
    }

</style>

<div class="container mt-4">

    <div class="card">

        <div class="card-body">

            <h3 class="fw-bold">

                Продажба

            </h3>

            <hr />

            <div class="mb-3">

                <label class="text-muted">

                    Артикл

                </label>

                <h4>

                    @Model.Name

                </h4>

            </div>


            <div class="mb-3">

                <label class="text-muted">

                    Категорија

                </label>

                <div>

                    @Model.Category.Name

                </div>

            </div>


            <div class="mb-3">

                <label class="text-muted">

                    Шифра

                </label>

                <div>

                    @Model.ProductCode

                </div>

            </div>


            <hr />


            <form method="post">

                <input name="productId"
                       value="@Model.Id"
                       hidden />


                <div class="mb-3">

                    <label>

                        Боја

                    </label>

                    <select id="colorSelect"
                            class="form-select">

                        <option value="">

                            Избери боја

                        </option>

                        @foreach (var color in
                        Model.Variants
                        .Select(x => x.Color)
                        .Distinct())
                        {
                            <option value="@color">

                                @color

                            </option>
                        }

                    </select>

                </div>



                <div class="mb-3">

                    <label>

                        Величина

                    </label>

                    <select id="sizeSelect"
                            name="inventoryId"
                            class="form-select">

                        <option value="">

                            Избери величина

                        </option>

                    </select>

                </div>



                <div class="mb-3">

                    <label>

                        Количина

                    </label>

                    <input type="number"
                           name="quantity"
                           value="1"
                           min="1"
                           class="form-control" />

                </div>



                <div class="mb-3">

                    <label>

                        Цена

                    </label>

                    <input type="number"
                           step="0.01"
                           name="price"
                           value="@Model.SalePrice"
                           class="form-control" />

                </div>



                <button class="btn btn-success w-100">

                    💰 Продади

                </button>

            </form>

        </div>

    </div>

</div>



<script>

    const variants =
    @Html.Raw(
    Json.Serialize(
    Model.Variants.Select(v => new
    {

        color = v.Color,

        inventories =
    v.Inventories.Select(i => new
    {

        id = i.Id,

        size = i.Size,

        quantity = i.Quantity

    })
    })
    ));



    document
    .getElementById(
    "colorSelect")

    .addEventListener(
    "change",

    function(){

    const color =
    this.value;

    const sizeSelect =
    document
    .getElementById(
    "sizeSelect");

    sizeSelect.innerHTML =
    '<option value="">Избери величина</option>';

    const variant =
    variants.find(
    x=>x.color===color);

    if(!variant)
    {
    return;
    }

    variant.inventories
    .forEach(inv=>{

    if(inv.quantity>0)
    {
    sizeSelect.innerHTML +=
    `
    <option value="${inv.id}">

    ${inv.size}
    (${inv.quantity} пар.)

    </option>
    `;
    }

    });

    });

</script>