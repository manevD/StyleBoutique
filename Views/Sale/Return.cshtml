@model BoutiqueQuantity.Entities.Sale

<style>

    .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .form-control {
        height: 55px;
        border-radius: 14px;
    }

    .btn {
        border-radius: 14px;
        height: 50px;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 16px;
        padding: 15px;
    }

</style>

<div class="container mt-4">

    <div class="card">

        <div class="card-body">

            <h3 class="fw-bold mb-4">

                ↩ Поврат

            </h3>


            <!-- PRODUCT INFO -->

            <div class="info-box mb-4">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <small class="text-muted">

                            Артикл

                        </small>

                        <div class="fw-bold">

                            @Model.ProductName

                        </div>

                    </div>


                    <div class="col-md-3 mb-3">

                        <small class="text-muted">

                            Боја

                        </small>

                        <div class="fw-bold">

                            @Model.Color

                        </div>

                    </div>


                    <div class="col-md-3 mb-3">

                        <small class="text-muted">

                            Величина

                        </small>

                        <div class="fw-bold">

                            @Model.Size

                        </div>

                    </div>

                </div>



                <div class="row mt-2">

                    <div class="col-md-4 mb-3">

                        <small class="text-muted">

                            Продадено

                        </small>

                        <div class="fw-bold text-primary">

                            @Model.Quantity

                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <small class="text-muted">

                            Вратено

                        </small>

                        <div class="fw-bold text-danger">

                            @Model.ReturnedQuantity

                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <small class="text-muted">

                            Достапно за враќање

                        </small>

                        <div class="fw-bold text-success">

                            @Model.RealQuantity

                        </div>

                    </div>

                </div>



                <div class="row mt-2">

                    <div class="col-md-6 mb-3">

                        <small class="text-muted">

                            Продажна цена

                        </small>

                        <div class="fw-bold">

                            @Model.SalePrice ден.

                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small class="text-muted">

                            Датум

                        </small>

                        <div class="fw-bold">

                            @Model.CreatedAt

                        </div>

                    </div>

                </div>

            </div>



            <!-- FORM -->

            <form method="post">

                <input type="hidden"
                       name="saleId"
                       value="@Model.Id" />


                <div class="mb-3">

                    <label class="mb-2">

                        Количина за враќање

                    </label>

                    <input type="number"
                           name="quantity"
                           min="1"
                           max="@Model.RealQuantity"
                           value="1"
                           class="form-control" />

                </div>



                <div class="mb-4">

                    <label class="mb-2">

                        Причина

                    </label>

                    <textarea name="reason"
                              rows="4"
                              class="form-control"
                              style="height:auto">

                    </textarea>

                </div>



                <div class="row">

                    <div class="col-md-6 mb-2">

                        <button class="btn btn-danger w-100">

                            ↩ Потврди поврат

                        </button>

                    </div>


                    <div class="col-md-6 mb-2">

                        <a asp-controller="Sale"
                           asp-action="Index"
                           class="btn btn-dark w-100">

                            Назад

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>